# AI-Driven Multi-Vendor Network Security Compliance Auditor — environment
# template. Copy to `.env`, adjust as needed. No real secrets belong here.

# --- Core data services -----------------------------------------------
DATABASE_URL=postgresql+psycopg2://compliance:compliance@postgres:5432/compliance
NATS_URL=nats://nats:4222
EVIDENCE_BUCKET=compliance-artifacts

# --- OPA: authoritative deterministic policy engine (RULE 2, RULE 14) --
OPA_URL=http://opa:8181
OPA_TIMEOUT=5.0
# block  = OPA_UNAVAILABLE fails the scan closed (BLOCK) — default, safest.
# review = OPA_UNAVAILABLE surfaces as REVIEW instead of BLOCK.
OPA_FAIL_MODE=block

# --- Batfish: network-behavior analysis engine (RULE 3, RULE 13) -------
BATFISH_ENABLED=true
# If true, an unsupported/unavailable Batfish result escalates the final
# decision to REVIEW even when OPA alone would have PASSed.
BATFISH_REQUIRED=false
BATFISH_HOST=batfish
BATFISH_PORT=9996
BATFISH_WORK_PORT=9997
BATFISH_TIMEOUT=120
BATFISH_SNAPSHOT_ROOT=/tmp/batfish/snapshots
BATFISH_IMAGE_VERSION=batfish/allinone:test-2024.07.22.1569

# --- Risk / correlation -------------------------------------------------
RISK_BLOCK_THRESHOLD=90
RISK_REVIEW_THRESHOLD=50

# --- Hyperledger Fabric: immutable evidence anchor (RULE 5, RULE 11) ----
FABRIC_ENABLED=false
FABRIC_GATEWAY_URL=http://fabric-gateway:8080
FABRIC_CHANNEL=compliance-audit-channel
FABRIC_CHAINCODE=compliance-evidence
FABRIC_ASYNC_ANCHOR=true
FABRIC_REQUIRED_FOR_CRITICAL_CHANGES=false
FABRIC_MAX_RETRIES=5
# --- AI / Local LLM ----------------------------------------------------
OLLAMA_HOST=http://100.95.230.65:8000
OLLAMA_BASE_URL=http://100.95.230.65:8000
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=bge-m3
AI_CONFIDENCE_THRESHOLD=0.75

# --- Private Hugging Face models ---------------------------------------
# READ-ONLY token for runtime use.
HF_TOKEN=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

HF_DISTILBERT_MODEL=
HF_MINILM_MODEL=

# Pin to a specific commit once the integration is frozen.
HF_MODEL_REVISION=main

# --- Trained AI pipeline ----------------------------------------------
AI_ENABLED=true

# Legacy local model paths
AI_CLASSIFIER_MODEL_PATH=
AI_EMBEDDING_MODEL_PATH=
AI_REFERENCE_DATASET=
AI_REFERENCE_EMBEDDINGS=

# Remote inference (optional): run DistilBERT and/or MiniLM on a separate
# host/GPU box instead of loading them into this process. Point these at
# a self-hosted inference server that accepts POST {"text": "..."} and
# returns {"intent","confidence","model_version"} (classifier) or
# {"embedding": [...]}(embedder). Leave blank to use the local model
# paths above (or the keyword/token-overlap fallback if those are blank
# too). AI_REMOTE_API_KEY/AI_REMOTE_TIMEOUT_SECONDS apply to both.
AI_CLASSIFIER_REMOTE_URL=http://100.95.230.65:8000/classify
AI_EMBEDDING_REMOTE_URL=http://100.95.230.65:8000/embed
AI_REMOTE_API_KEY=
AI_REMOTE_TIMEOUT_SECONDS=10

AI_CLASSIFIER_CONFIDENCE_THRESHOLD=0.75
AI_SEMANTIC_THRESHOLD=0.60
AI_MODEL_VERSION=distilbert-v3-minilm-v3

# --- Identity / secrets (self-hosted; fill in real values in your .env) -
KEYCLOAK_URL=http://keycloak:8080
OPENBAO_URL=http://openbao:8200
OPENBAO_TOKEN=dev-root-token-change-me

# --- Object storage ------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=compliance
MINIO_SECRET_KEY=c0lrznmw8cUHOg3oL65w2zv564yim71f4XM/plcImZU=

# --- Observability ---------------------------------------------------------
VICTORIAMETRICS_URL=http://victoriametrics:8428

# --- Optional: OpenConfig/gNMI configuration injection (spec 22-28) -------
# Disabled by default. Only takes effect through the approved ChangeRequest
# deploy workflow (never AI -> gNMI, never browser -> gNMI directly).
OPENCONFIG_ENABLED=false
GNMI_ENABLED=false
GNMI_TIMEOUT=10
GNMI_PORT=6030
GNMI_TLS_ENABLED=true
GNMI_CA_CERT=
GNMI_CLIENT_CERT=
GNMI_CLIENT_KEY=
OPENCONFIG_MODEL_PATH=

# --- Optional: pyATS/Genie verification (spec 29-34, Cisco-only) ---------
# Disabled by default. Supplemental evidence only; never authoritative for
# compliance (OPA) or network behavior (Batfish).
PYATS_ENABLED=false
PYATS_TESTBED_PATH=
PYATS_TIMEOUT=30
PYATS_VERIFY_COMMANDS=

# --- Auth: set to false for local prototype testing -----------------
AUTH_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
JOB_SIGNING_SECRET=dev-only-change-in-prod-3add681280780d401f71d0005fcfaeb8
