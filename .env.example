# AI-Driven Multi-Vendor Network Security Compliance Auditor — environment
# template. Copy to `.env`, adjust as needed. No real secrets belong here.

# --- Core data services -----------------------------------------------
DATABASE_URL=postgresql+psycopg2://compliance:compliance@postgres:5432/compliance
NATS_URL=nats://nats:4222
EVIDENCE_BUCKET=compliance-artifacts

# --- OPA: authoritative deterministic policy engine (RULE 2, RULE 14) --
OPA_URL=http://opa:8181
OPA_TIMEOUT=5.0
# block  = OPA_UNAVAILABLE fails the scan closed (BLOCK) — default, safest.
# review = OPA_UNAVAILABLE surfaces as REVIEW instead of BLOCK.
OPA_FAIL_MODE=block

# --- Batfish: network-behavior analysis engine (RULE 3, RULE 13) -------
BATFISH_ENABLED=true
# If true, an unsupported/unavailable Batfish result escalates the final
# decision to REVIEW even when OPA alone would have PASSed.
BATFISH_REQUIRED=false
BATFISH_HOST=batfish
BATFISH_PORT=9996
BATFISH_WORK_PORT=9997
BATFISH_TIMEOUT=120
BATFISH_SNAPSHOT_ROOT=/tmp/batfish/snapshots
BATFISH_IMAGE_VERSION=batfish/allinone:test-2024.07.22.1569

# --- Risk / correlation -------------------------------------------------
RISK_BLOCK_THRESHOLD=90
RISK_REVIEW_THRESHOLD=50

# --- Hyperledger Fabric: immutable evidence anchor (RULE 5, RULE 11) ----
FABRIC_ENABLED=false
FABRIC_GATEWAY_URL=http://fabric-gateway:8080
FABRIC_CHANNEL=compliance-audit-channel
FABRIC_CHAINCODE=compliance-evidence
FABRIC_ASYNC_ANCHOR=true
FABRIC_REQUIRED_FOR_CRITICAL_CHANGES=false
FABRIC_MAX_RETRIES=5

# --- AI/RAG normalization (never the compliance engine — RULE 1) -------
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
AI_CONFIDENCE_THRESHOLD=0.75

# --- Identity / secrets (self-hosted; fill in real values in your .env) -
KEYCLOAK_URL=http://keycloak:8080
OPENBAO_URL=http://openbao:8200
OPENBAO_TOKEN=

# --- Object storage ------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=compliance
MINIO_SECRET_KEY=change-me-in-real-env

# --- Observability ---------------------------------------------------------
VICTORIAMETRICS_URL=http://victoriametrics:8428
